# Kopioi nimelle .env ja täytä. Älä lisää .enviä gitiin.

# Kirjautuminen sivulle (HTTP Basic). Pakollinen, jos sivu näkyy muille kuin sinulle.
PELTOLOHKO_KAYTTAJA=beanstalk
PELTOLOHKO_SALASANA=

# Missä data on NAS:lla ja missä portissa sivu näkyy
BEANSTALK_DATA=/share/Container/beanstalk/data
BEANSTALK_PORTTI=8765

# Copernicus Data Space (Sentinel-1, Sentinel-2/openEO): dataspace.copernicus.eu -> OAuth client
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
# Copernicus Climate Data Store (ERA5-Land): cds.climate.copernicus.eu -> API key
CDS_API_KEY=
# Planet (PlanetScope, valinnainen ja maksullinen)
PL_API_KEY=
# Maanmittauslaitos (valinnainen: maastotietokanta, taustakartat)
MML_API_KEY=
